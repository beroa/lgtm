{
  "name": "github-diff-collapser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open /pages/options.html",
    "format": "prettier --write .",
    "check": "tsc --noEmit && eslint .",
    "test": "tsx --test tests/*.test.ts",
    "build:chrome": "tsx vite.build.ts chrome",
    "build:firefox": "tsx vite.build.ts firefox",
    "build:all": "yarn build:chrome && yarn build:firefox"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.36",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.3.0",
    "linkedom": "^0.18.14",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.55.0",
    "vite": "^7.3.1"
  }
}
