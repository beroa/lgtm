{
  "manifest_version": 3,
  "name": "GitHub Diff Collapser",
  "version": "0.1.0",
  "description": "Automatically collapse GitHub file diffs matching your regex patterns.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "pages/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GitHub Diff Collapser",
    "default_popup": "pages/options.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
